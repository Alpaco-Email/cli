{
  "name": "@alpaco-email/cli",
  "version": "0.0.0",
  "description": "Pull, validate and push Alpaco template designs from your code editor",
  "license": "MIT",
  "type": "module",
  "bin": {
    "alpaco": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/core/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alpaco-Email/cli.git"
  },
  "homepage": "https://github.com/Alpaco-Email/cli#readme",
  "keywords": [
    "alpaco",
    "email",
    "liquid",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "liquidjs": "^10.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
